# Copy to .env.local and fill in. Never commit real values.
# Admin login password for the owner dashboard (required to use /admin).
ADMIN_PASSWORD=change-me-to-a-strong-password
# 32+ random characters used to sign admin sessions (required).
SESSION_SECRET=replace-with-at-least-32-random-characters
# SQLite file location. Defaults to ./data/esc.sqlite
DATABASE_PATH=./data/esc.sqlite
# Optional: public business name shown in the UI
BUSINESS_NAME=Executive Suit Care
